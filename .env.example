# Prisma uses MySQL. Use a separate local database for development.
DATABASE_URL="mysql://clinic:change-me@localhost:3306/clinic"
PORT=5000
NODE_ENV=development
# Required in production; generate a long random value outside source control.
SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Only used by the explicit admin:create command. Never use default credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
